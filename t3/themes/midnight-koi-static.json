{
  "version": 1,
  "name": "Midnight Koi Vector (Static)",
  "appearance": "dark",
  "canvas": "#13131d",
  "accent": "#c5b2ec",
  "colors": {
    "canvas": "#13131d",
    "chrome": "#1d1b2b",
    "toolbar": "#191826",
    "toolbarForeground": "#e3ddec",
    "toolbarBorder": "#3b354b",
    "toolbarControl": "#2a263b",
    "toolbarControlForeground": "#e5dfef",
    "toolbarControlHover": "#38304a",
    "surface": "#181724",
    "surfaceRaised": "#272338",
    "surfaceOverlay": "#211e2f",
    "text": "#e3deeb",
    "textMuted": "#b7aec7",
    "border": "#3e374e",
    "input": "#211e30",
    "focus": "#c2aff0",
    "accent": "#c5b2ec",
    "accentForeground": "#211832",
    "secondary": "#342c48",
    "secondaryForeground": "#e0d6ed",
    "muted": "#27233a",
    "mutedForeground": "#b7aec7",
    "placeholder": "#b7aec7",
    "secondaryLabel": "#c3bad1",
    "iconMuted": "#aca0bf",
    "error": "#e79a91",
    "errorForeground": "#f3b5ad",
    "errorSurface": "#392623",
    "warning": "#d6b779",
    "warningForeground": "#eed4a2",
    "warningSurface": "#352e20",
    "update": "#b9c9ad",
    "updateForeground": "#cedec2",
    "updateSurface": "#2d3429",
    "accentSurface": "#382e4f",
    "accentSurfaceForeground": "#d9c9f7",
    "messageSurface": "#30283e",
    "messageForeground": "#e3deeb",
    "messageAction": "#3d3450",
    "messageActionForeground": "#e4dbef",
    "messageActionHover": "#4a3d60",
    "codeBackground": "#12111c",
    "codeForeground": "#d6cce5",
    "searchMatchBackground": "#5a4e2e",
    "searchMatchForeground": "#efdc9b",
    "searchMatchActiveBackground": "#d3bc7b",
    "searchMatchActiveForeground": "#211832",
    "sidebar": "#151521",
    "sidebarForeground": "#d8d0e5",
    "sidebarMutedForeground": "#afa4c0",
    "sidebarControlSurface": "#282338",
    "sidebarRowHover": "#211f30",
    "sidebarRowActive": "#282439",
    "sidebarRowSelected": "#332943",
    "sidebarBorder": "#343045",
    "terminalBackground": "#12111c",
    "terminalForeground": "#d6cce5",
    "terminalCursor": "#c5b2ec",
    "terminalSelection": "#493c5e",
    "terminalScrollbar": "#3f3553",
    "terminalScrollbarHover": "#635275"
  },
  "css": ":root{--midnight-koi-sharks:url(\"data:image/svg+xml;base64,\")}\n:root {\n  --font-sans: \"Avenir Next\", Avenir, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif !important;\n}\nbody,\n:is([data-slot=\"sidebar\"], [data-chat-header], .messages-timeline-scroll, [data-user-message-bubble], .chat-markdown, [data-slot=\"composer-host\"], .composer-tiptap, [data-thread-details-card], [data-settings-page-scroll], [data-slot=\"dialog-popup\"], [data-slot=\"popover-popup\"], [data-slot=\"menu-popup\"], [data-slot=\"tooltip-popup\"]),\n[data-slot=\"button\"],\n[data-slot=\"input\"],\n[data-slot=\"select-trigger\"] {\n  font-family: \"Avenir Next\", Avenir, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif !important;\n  font-kerning: normal;\n}\n:is([data-slot=\"sidebar\"], [data-chat-header], .messages-timeline-scroll, [data-user-message-bubble], .chat-markdown, [data-slot=\"composer-host\"], .composer-tiptap, [data-thread-details-card], [data-settings-page-scroll], [data-slot=\"dialog-popup\"], [data-slot=\"popover-popup\"], [data-slot=\"menu-popup\"], [data-slot=\"tooltip-popup\"]) :where(p, span, a, button, input, textarea, div, label, h1, h2, h3, h4, h5, h6, li, td, th, summary, time):not(:where(code *, pre *, kbd *, samp *, .chat-markdown-codeblock, .chat-markdown-codeblock *, [data-thread-terminal-drawer], [data-thread-terminal-drawer] *)) {\n  font-family: \"Avenir Next\", Avenir, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif !important;\n}\n.chat-markdown,\n[data-user-message-bubble],\n.composer-tiptap {\n  font-size: 1rem;\n  line-height: 1.65;\n  letter-spacing: normal;\n}\n.chat-markdown :is(h1, h2, h3, h4, h5, h6) {\n  font-weight: 600;\n  line-height: 1.3;\n  letter-spacing: -0.02em;\n  text-wrap: balance;\n}\n.chat-markdown :is(strong, b) {\n  font-weight: 600;\n}\n[data-chat-header], [data-thread-item] {\n  letter-spacing: -0.01em;\n}\n:is(code, pre, kbd, samp, .chat-markdown-codeblock),\n:is(code, pre, kbd, samp, .chat-markdown-codeblock) * {\n  font-family: var(--font-mono, ui-monospace, \"SFMono-Regular\", Menlo, Consolas, monospace) !important;\n  letter-spacing: normal;\n}\n\n\n.dark [data-workspace-area=\"conversation\"],\n.dark [data-chat-composer-overlay=\"true\"].items-center {\n  --koi-backdrop:\n    radial-gradient(ellipse 62% 76% at 93% 4%, #7052a66b 0%, #4b337d44 34%, transparent 76%),\n    radial-gradient(ellipse 61% 66% at 4% 106%, #673c736f 0%, #44265355 37%, transparent 78%),\n    radial-gradient(ellipse 80% 74% at 99% 89%, #394c8c38 0%, transparent 70%),\n    linear-gradient(145deg, #090913 4%, #18142a 50%, #0b0c1b 100%);\n  background: linear-gradient(90deg,#10101a12,#10101a49 38%,#10101a39 65%,#10101a12), var(--midnight-koi-sharks) center / contain no-repeat, var(--koi-backdrop) !important;\n}\n.dark .messages-timeline-scroll { background: transparent !important; }\n.dark [data-slot=\"sidebar\"] {\n  background: #151521 !important;\n  border-right: 1px solid #343045 !important;\n}\n.dark [data-slot=\"sidebar-inner\"] {\n  background: #151521 !important;\n}\n.dark [data-slot=\"sidebar\"] .drag-region:has(a[aria-label=\"T3 Code home\"]) {\n  background: #1d1b2b !important;\n  box-shadow: inset 0 -1px #393449, inset 0 1px #ffffff09;\n}\n.dark [data-slot=\"sidebar\"] a[aria-label=\"T3 Code home\"] {\n  color: #f0e9f8 !important;\n}\n.dark [data-slot=\"sidebar-footer\"] {\n  box-shadow: inset 0 1px #393449;\n}\n.dark [data-chat-header] {\n  background: #191826 !important;\n  border-bottom: 1px solid #3b354b !important;\n  box-shadow: 0 3px 12px #08071069, inset 0 1px #ffffff09;\n  backdrop-filter: none;\n}\n.dark [data-slot=\"sidebar\"] [data-sidebar-row][aria-current]:not([aria-current=\"false\"]) {\n  background: #282439 !important;\n  box-shadow: inset 0 0 0 1px #534766, 0 2px 6px #0807104d;\n}\n.dark [data-slot=\"sidebar\"] [data-sidebar-row][aria-current]:not([aria-current=\"false\"]):hover {\n  background: #2e293f !important;\n}\n.dark [data-slot=\"sidebar\"] [data-sidebar-row]:focus-visible {\n  outline: 1px solid #c2aff0;\n  outline-offset: -2px;\n}\n.dark .topbar-scroll-fade:has([data-changed-files-state=\"tree\"]) {\n  mask: none;\n}\n.dark [data-changed-files-state=\"tree\"] {\n  background: linear-gradient(155deg, #28253ca8, #14132185);\n  backdrop-filter: blur(16px) saturate(120%);\n  box-shadow: inset 0 0 0 1px #ddd0f41c, 0 6px 18px #09081240;\n\n  & > [data-changed-files-header] {\n    background: #d7c9ff08;\n    backdrop-filter: blur(8px);\n  }\n}\n.dark [data-thread-details-card] {\n  background: linear-gradient(140deg,#30273fe8,#1c1929ee) !important;\n  border: 1px solid #ae9bc345 !important;\n  box-shadow: 0 12px 35px #08061245, inset 0 1px #e7d7fc11;\n  backdrop-filter: blur(18px) saturate(115%);\n}\n.dark [data-slot=\"composer-host\"] {\n  --chat-composer-outline: transparent;\n  --chat-composer-highlight: transparent;\n  background:\n    radial-gradient(ellipse 120% 95% at 8% -28%, #a9dfd124, transparent 67%) border-box,\n    linear-gradient(transparent calc(100% - 15px), #050b1150) border-box,\n    radial-gradient(125% 105% at 22% 0%, #293f40 0%, #202f34 19%, transparent 49%),\n    linear-gradient(151deg, #242e35 0%, #202930 32%, #1e262e 63%, #1c242c 100%) !important;\n  border: 1px solid rgb(225 239 238 / 10%) !important;\n  border-radius: 18px;\n  color: #e3efed;\n  box-shadow:\n    inset 1px 2px 3px -1px #b5e4d95c,\n    inset -1px -2px 4px -1px #04090f9e,\n    0 2px 3px -1px #04080de0,\n    2px 8px 16px -6px #04080db8;\n}\n.dark [data-slot=\"composer-host\"]::before {\n  background: none;\n  backdrop-filter: none;\n}\n.dark [data-chat-composer-form] {\n  .composer-tiptap {\n    caret-color: #a8d8cb;\n  }\n  [data-chat-provider-model-picker] {\n    color: #dde9e6;\n    &:focus-visible {\n      outline: 2px solid #b5e6d9;\n      outline-offset: 2px;\n    }\n    @media (hover: hover) {\n      &:enabled:hover {\n        background: #92cfc021;\n        color: #f0faf7;\n      }\n    }\n  }\n  button:is(\n    .rounded-full.bg-message-action,\n    .rounded-full.isolate.overflow-hidden[type=\"submit\"],\n    .rounded-full[class~=\"bg-destructive/90\"],\n    [data-chat-composer-transition-actions],\n    [aria-label$=\" voice input\"],\n    [aria-label=\"Attach files\"],\n    [data-slot=\"voice-input-pill\"] > :not([aria-label])\n  ) {\n    --chamfer: inset 1px 1px 2px #d5f5e75c, 1px 2px 3px -1px #03090de0;\n    --depressed: inset 1px 2px 3px #03090d8c;\n    background: linear-gradient(145deg, #a0cebf, #73a69b);\n    color: #122b29;\n    box-shadow: var(--chamfer);\n    scale: none;\n    transition: background-color 95ms ease-out, box-shadow 95ms ease-out, filter 95ms ease-out;\n\n    &:is([aria-label=\"Queue message\"], [aria-label=\"Update queued message\"]) {\n      background: linear-gradient(145deg, #705685, #4a395c);\n      color: #f4e8ff;\n    }\n    &[aria-label=\"Steer message\"] {\n      background: linear-gradient(145deg, #595580, #3e385a);\n      color: #f0eafa;\n    }\n    &:is([class~=\"bg-destructive/90\"], [aria-label=\"Cancel voice input\"]) {\n      background: linear-gradient(145deg, #9a5861, #673a47);\n      color: #fff0f2;\n    }\n    &:disabled {\n      background: #303340;\n      box-shadow: var(--depressed);\n      color: #b8bed0;\n      opacity: 1;\n    }\n    &:disabled[class~=\"bg-destructive/90\"] {\n      background: #50343c;\n      color: #dbafb8;\n    }\n    &:disabled:has(> svg:not([class]) > path[stroke=\"currentColor\"]) {\n      background: #26373a linear-gradient(#ffffff0c, transparent);\n      box-shadow: inset 0 0 0 1px #b9e4d630;\n      color: #a0bab7;\n      cursor: default;\n      @media (hover: hover) and (pointer: fine) {\n        pointer-events: auto;\n        &:hover { background-color: #30474a; }\n      }\n    }\n    &:enabled:focus-visible {\n      outline: 2px solid #b5e6d9;\n      outline-offset: 2px;\n    }\n    @media (hover: hover) and (pointer: fine) {\n      &:enabled:hover:not(:active) { filter: brightness(1.14); }\n    }\n    &:enabled:active {\n      box-shadow: var(--depressed);\n      filter: brightness(.90);\n      transition-duration: 45ms;\n    }\n    &:is([aria-label=\"Attach files\"], [aria-label=\"Start voice input\"], [data-slot=\"voice-input-pill\"] > :not([aria-label])) {\n      --chamfer: inset 1px 1px 2px #b9e4d629, 1px 2px 3px -1px #03090da6;\n      background: linear-gradient(145deg, #b2e7d616, #4a686512);\n      color: #d0e5e0;\n      &:enabled:active { background-color: #233332; }\n      &:disabled { opacity: .65; }\n      @media (hover: hover) and (pointer: fine) {\n        &:enabled:hover:not(:active) {\n          background-color: #2d4644;\n          color: #f0faf7;\n          filter: none;\n        }\n      }\n    }\n    @media (prefers-reduced-motion: reduce) {\n      &, &:enabled:active { transition: none; }\n    }\n  }\n  button:is(.rounded-full.bg-message-action, [data-chat-composer-transition-actions])\n    svg:not([class]) path[stroke=\"currentColor\"] {\n    stroke-width: 1.6;\n  }\n}\n\n.dark [data-user-message-bubble] {\n  background: #30273ee8 !important;\n  border: 1px solid #a088b726;\n  backdrop-filter: blur(12px);\n}\n.dark .chat-markdown-codeblock { background: #12111cf5 !important; }\n.dark :is([data-slot=\"dialog-popup\"],[data-slot=\"popover-popup\"],[data-slot=\"menu-popup\"]) {\n  background: #211e2ff5 !important;\n  border-color: #85719d4d !important;\n  backdrop-filter: blur(18px);\n}\n.dark .composer-tiptap [data-placeholder]::before,\n.dark .composer-tiptap::before { color: #bdcecd !important; }\n.dark [data-thread-item] { border-radius: 10px; }\n.dark ::selection { background: #826ba877; color: #f2eafa; }\n.dark ::-webkit-scrollbar-thumb { background: #73638580; border-radius: 8px; }\n.dark ::-webkit-scrollbar-thumb:hover { background: #9682afaa; }\n@media (prefers-reduced-motion: reduce) {\n  .dark [data-workspace-area=\"conversation\"],\n.dark [data-chat-composer-overlay=\"true\"].items-center {\n    background-image: var(--koi-backdrop) !important;\n  }\n}\n\n.dark [data-slot=\"button\"][class~=\"bg-destructive\"] {\n  --destructive: #a34250;\n}\n"
}