{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "none"
    },
    "display": {
        "separator": " ❯ ",
        "color": {
            "keys": "#c49a3a",
            "title": "#ab8fd4",
            "separator": "#b0b4ba"
        },
        "key": {
            "paddingLeft": 2
        },
        "bar": {
            "width": 10,
            "char": {
                "total": "-",
                "elapsed": "■"
            }
        },
        "percent": {
            "type": 2,
            "color": {
                "green": "#2d8a22",
                "yellow": "#c49a3a",
                "red": "#e05661"
            }
        },
        "temp": {
            "color": {
                "green": "#2d8a22",
                "yellow": "#c49a3a",
                "red": "#e05661"
            }
        }
    },
    "modules": [
        {
            "type": "title",
            "format": "  {user-name-colored}{at-symbol-colored}{host-name-colored}"
        },
        {
            "type": "custom",
            "key": " ",
            "format": "  ----------------"
        },
        {
            "type": "os",
            "key": "OS           "
        },
        {
            "type": "cpu",
            "key": "CPU_temp     ",
            "temp": true,
            "format": "{temperature}"
        },
        {
            "type": "gpu",
            "key": "GPU_temp     ",
            "temp": true,
            "format": "{temperature}"
        },
        // "host",
        // "kernel",
        {
            "type": "uptime",
            "key": "Uptime       "
        },
        {
            "type": "packages",
            "key": "Packages     "
        },
        // "shell",
        // "display",
        // "de",
        // "wm",
        // "wmtheme",
        // "theme",
        // "icons",
        // "font",
        // "cursor",
        {
            "type": "terminal",
            "key": "Terminal     "
        },
        {
            "type": "terminalfont",
            "key": "Terminal Font"
        },
        {
            "type": "memory",
            "key": "Memory       "
        },
        // "swap",
        {
            "type": "disk",
            "key": "Disk         ",
            "format": "{size-percentage-bar} {size-used} / {size-total}"
        },
        // "localip",
        {
            "type": "battery",
            "key": "Battery      "
        },
        // "poweradapter",
        // "locale",
        "break",
        // "colors"
        {
            "type": "datetime",
            "key": "Date         ",
            "format": "{weekday-short} {day-pretty}/{month-pretty}/{year-short}"
        },
        "break"
    ]
}
