shell-integration = zsh

# Ghostty Theme Config
theme = onedarkpro_onelight
window-theme = light

#background-opacity = 0.8
cursor-style = block
cursor-style-blink = true
window-padding-x = 20
window-padding-y = 10
bold-is-bright = true

custom-shader = shaders/cursor_warp.glsl

font-family = "BlexMono Nerd Font Mono"
font-size = 15
font-feature = ["ss01", "ss02", "ss03", "calt", "liga"] # Enables IBM Plex's professional alternates

copy-on-select = clipboard
window-save-state = always
quit-after-last-window-closed = true

macos-option-as-alt = true
keybind = super+backspace=esc:w
keybind = opt+]=scroll_page_down
keybind = opt+[=scroll_page_up
keybind = opt+g=scroll_to_top

keybind = global:super+grave_accent=toggle_quick_terminal

# -----------------
# Use Alt + direction (h, j, k, l) for creating new splits,
# similar to Vim navigation.
keybind = opt+h=new_split:left
keybind = opt+l=new_split:right
keybind = opt+k=new_split:up
keybind = opt+j=new_split:down

# Use a more intuitive shortcut for the 'auto' split.
keybind = ctrl+slash=new_split:auto

# Navigate between splits
# -----------------------
# Use Ctrl + direction (h, j, k, l) for moving between splits.
# This is a common convention in terminal applications. [2]
keybind = ctrl+h=goto_split:left
keybind = ctrl+l=goto_split:right
keybind = ctrl+k=goto_split:up
keybind = ctrl+j=goto_split:down

keybind = super+l=clear_screen
keybind = shift+enter=text:\x1b\r
