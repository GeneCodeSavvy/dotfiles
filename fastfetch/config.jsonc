{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "auto",
        "source": "~/.config/fastfetch/pixil-frame-0.png",
        "width": 20,
        "height": 9,
        "padding": {
            "top": 3,
            "left": 3
        }
    },
    "display": {
        "separator": " ❯ ",
        "color": {
            "keys": "yellow",
            "title": "magenta"
        },
        "bar": {
            "width": 10,
            "char": {
                "total": "-",
                "elapsed": "■"
            }
        },
        "percent": {
            "type": 2
        }
    },
    "modules": [
        "title",
        "separator",
        "os",
        {
            "type": "cpu",
            "key": "CPU_temp",
            "keyColor": "yellow",
            "temp": true,
            "format": "{temperature}"
        },
        {
            "type": "gpu",
            "key": "GPU_temp",
            "keyColor": "yellow",
            "temp": true,
            "format": "{temperature}"
        },
        // "host",
        // "kernel",
        "uptime",
        "packages",
        // "shell",
        // "display",
        // "de",
        // "wm",
        // "wmtheme",
        // "theme",
        // "icons",
        // "font",
        // "cursor",
        "terminal",
        "terminalfont",
        "memory",
        // "swap",
        {
            "type": "disk",
            "key": "Disk",
            "format": "{size-percentage-bar} {size-used} / {size-total}"
        },
        // "localip",
        {
            "type": "battery",
            "key": "Battery"
        },
        // "poweradapter",
        // "locale",
        "break",
        // "colors"
        {
            "type": "datetime",
            "key": "Date",
            "format": "{weekday-short} {day-pretty}/{month-pretty}/{year-short}"
        },
        "break"
    ]
}
